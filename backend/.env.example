GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Optional model cache settings. Set one to use a persistent cache.
# HF_HOME=./model-cache
# TRANSFORMERS_CACHE=./model-cache
# SENTENCE_TRANSFORMERS_HOME=./model-cache
# Set to 1 after pre-downloading model files to disable Hugging Face network access.
# HF_HUB_OFFLINE=1
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_NAME=deskai_knowledge
RAG_RELEVANCE_THRESHOLD=0.35
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Required to enable POST /api/admin/warmup; use a strong private value.
ADMIN_API_KEY=
# Optional PEM CA bundle for a corporate TLS-inspection proxy:
# GROQ_CA_BUNDLE=C:/certs/corporate-root-ca.pem
